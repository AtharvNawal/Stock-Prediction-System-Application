# Settings are read from the environment: export these in your shell, or set them in your
# host's dashboard. The app does not load .env files itself. Never commit real secrets.

# Local development: debug on, any secret is fine
DJANGO_DEBUG=1

# Production: debug off, a long random secret, your domain
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=investiq.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://investiq.example.com
# RATE_LIMIT_TRUSTED_PROXIES=1   # behind one load balancer (Heroku, Render, Railway)

SQLITE_PATH=./db.sqlite3
